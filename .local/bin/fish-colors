#!/usr/bin/env bash

CSS="$HOME/.config/waybar/colors.css"
OUT="$HOME/.config/fish/conf.d/matugen.fish"

get() {
  sed -n "s/.*@define-color $1 \(#[0-9a-fA-F]\+\).*/\1/p" "$CSS"
}

cat > "$OUT" <<EOF
# Auto-generated by matugen – DO NOT EDIT

set -g MAT_BG        "$(get background)"
set -g MAT_SURFACE   "$(get surface)"
set -g MAT_PRIMARY   "$(get primary)"
set -g MAT_SECONDARY "$(get secondary)"
set -g MAT_TERTIARY  "$(get tertiary)"
set -g MAT_ERROR     "$(get error)"
set -g MAT_OUTLINE   "$(get outline)"
set -g MAT_ON_SURF   "$(get on_surface)"
EOF
